#!/usr/bin/env python3
"""Preflight Claude credentials before running Skillet evals.

Usage: scripts/eval-claude [--check] [skillet eval arguments]
       ANTHROPIC_API_KEY=op://Vault/Item/field scripts/eval-claude --check

The machine-local ~/.localrc is the default credential source. A 1Password
reference is resolved in memory; no secret is printed or written to a new file.
"""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import shlex
import subprocess
import sys

TIMEOUT_SECONDS = 25


def run(command: list[str], *, timeout: int = TIMEOUT_SECONDS) -> subprocess.CompletedProcess[str]:
    return subprocess.run(command, capture_output=True, text=True, timeout=timeout, check=False)


def load_localrc(*, use_oauth: bool) -> None:
    path = Path.home() / ".localrc"
    if not path.is_file() or use_oauth:
        return
    if os.environ.get("ANTHROPIC_API_KEY", "").startswith("op://"):
        return  # An explicit 1Password reference wins over a literal local key.
    # Source only the assignments, as .zshrc does. Never print the file.
    command = f"set -a; source {shlex.quote(str(path))}; env -0"
    result = run(["/bin/zsh", "-f", "-c", command])
    if result.returncode:
        sys.stderr.write("Could not read ~/.localrc; check its shell syntax.\n")
        raise SystemExit(1)
    for entry in result.stdout.split("\0"):
        if "=" in entry:
            name, value = entry.split("=", 1)
            os.environ[name] = value


def resolve_onepassword() -> None:
    reference = os.environ.get("ANTHROPIC_API_KEY", "")
    if not reference.startswith("op://"):
        return
    result = run(["op", "read", reference], timeout=30)
    if result.returncode:
        sys.stderr.write(
            "1Password could not resolve ANTHROPIC_API_KEY.\n"
            "Enable 1Password desktop app integration for the CLI, then run:\n"
            "  op signin\n"
            "and retry this command. The reference itself was not printed.\n"
        )
        raise SystemExit(1)
    os.environ["ANTHROPIC_API_KEY"] = result.stdout.strip()


def preflight() -> None:
    status = run(["claude", "auth", "status", "--json"])
    try:
        source = json.loads(status.stdout).get("apiKeySource")
    except json.JSONDecodeError:
        source = None  # No valid auth configured; preflight below reports the fix.

    try:
        result = run(
            ["claude", "-p", "Reply with exactly OK.", "--max-turns", "1", "--output-format", "text"],
        )
    except subprocess.TimeoutExpired:
        result = None

    if result is not None and result.returncode == 0:
        print(f"Claude credential preflight passed (source: {source or 'OAuth/keychain'}).")
        return

    if source == "ANTHROPIC_API_KEY":
        message = (
            "Claude is using ANTHROPIC_API_KEY from ~/.localrc or the environment,\n"
            "and that key was rejected or timed out. Your OAuth login cannot override it.\n"
            "Refresh it with ONE of these, then retry:\n"
            "  1. Replace the literal ANTHROPIC_API_KEY value in ~/.localrc.\n"
            "  2. Set ANTHROPIC_API_KEY=op://Vault/Item/field in ~/.localrc, run op signin,\n"
            "     and let this wrapper resolve it in memory.\n"
            "  3. Remove/unset ANTHROPIC_API_KEY and run: claude auth login\n"
            "     Then verify OAuth explicitly: env -u ANTHROPIC_API_KEY claude auth status\n"
        )
    else:
        message = (
            "Claude OAuth could not be refreshed. Run this interactively:\n"
            "  claude auth login\n"
            "Then verify: claude auth status\n"
        )
    detail = ""
    if result is not None:
        detail = (result.stderr or result.stdout).strip()
    sys.stderr.write(message + (f"\nClaude said: {detail}\n" if detail else ""))
    raise SystemExit(1)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true", help="only run the credential preflight")
    parser.add_argument("--oauth", action="store_true", help="ignore ~/.localrc key; force OAuth login")
    parser.add_argument("--skill", default="skills/structure-authoring")
    parser.add_argument("arguments", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    load_localrc(use_oauth=args.oauth)
    if args.oauth:
        os.environ.pop("ANTHROPIC_API_KEY", None)
    resolve_onepassword()
    preflight()
    if args.check:
        return 0
    command = ["npx", "-y", "@sentry/skillet@latest", "eval", args.skill, "--harness", "claude", *args.arguments]
    return subprocess.run(command, env=os.environ).returncode


if __name__ == "__main__":
    raise SystemExit(main())
