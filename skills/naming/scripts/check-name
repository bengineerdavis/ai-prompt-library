#!/usr/bin/env python3
"""check-name — probe candidate project/package names across registries.

Deterministic, read-only availability check. Never publishes anything; it only
asks the registries. Stdlib-only, runs without a venv.

Output: one JSON object per token (or an array) with namespace status, watchlist
hits, alias reservation, and a top-level `gate` verdict.

Exit codes: 0 = every token `free`, 1 = any token not free, 2 = usage error.
"""

import argparse
import datetime
import json
import sys
import urllib.error
import urllib.request

UA = {"User-Agent": "check-name/1.0"}

DEFAULT_WATCHLIST = {
    "canopy": {"brand": "Enthought Canopy / Pinecone Canopy", "note": "PyPI taken + github.com/canopy org"},
    "codex": {"brand": "OpenAI Codex", "note": "synonymous with the model"},
    "orchard": {"brand": "Orchard CMS", "note": "major open-source platform"},
    "radix": {"brand": "Radix UI", "note": "dominant in developer mindshare"},
    "delta": {"brand": "git plumbing / delta pager", "note": "collides with git itself"},
    "grove": {"brand": "nicksenap/grove", "note": "git worktree orchestrator, same domain"},
    "garden": {"brand": "garden-rs/garden", "note": "multi-repo tool"},
    "coppice": {"brand": "iamfozzy/coppice", "note": "git-worktree manager"},
    "got": {"brand": "sindresorhus/got + crates got", "note": "HTTP client + rust git CLI + go get"},
    "gud": {"brand": "git-gud", "note": "the joke is already taken, twice"},
    "radicle": {"brand": "radicle-dev", "note": "P2P decentralized git project"},
    "estuary": {"brand": "estuary.dev", "note": "data-sync tool"},
    "aqueduct": {"brand": "stablekernel/aqueduct", "note": "Dart framework"},
    "trellis": {"brand": "agent-harness Trellis", "note": "14k stars"},
    "willow": {"brand": "Nike Willow / HeyWillow", "note": "multiple strong brands"},
    "mangrove": {"brand": "Mangrove DAO", "note": "known brand"},
    "unison": {"brand": "Unison file synchronizer", "note": "sync tool, exact concept"},
}

RESERVED_ALIASES = {
    "gc": "git checkout muscle memory",
    "dt": "datetime abbreviation",
    "dist": "distribution / distutils",
    "dis": "negative prefix",
    "gcp": "Google Cloud Platform",
}


def _get(url, timeout=10):
    req = urllib.request.Request(url, headers=UA)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            raw = r.read().decode()
            try:
                return r.status, json.loads(raw)
            except json.JSONDecodeError:
                return r.status, raw
    except urllib.error.HTTPError as e:
        return e.code, None
    except Exception as e:  # network / timeout
        return None, str(e)


def probe_pypi(name, base="https://pypi.org/pypi", **kw):
    status, data = _get(f"{base}/{name}/json")
    if status == 404:
        return {"status": "free"}
    if status == 200 and isinstance(data, dict):
        info = data.get("info", {}) or {}
        newest = None
        for files in (data.get("releases") or {}).values():
            for f in files:
                up = f.get("upload_time")
                if up and (newest is None or up > newest):
                    newest = up
        return {"status": "taken", "name": info.get("name"), "version": info.get("version"),
                "summary": info.get("summary"), "last_upload": newest}
    return {"status": "unknown", "detail": data}


def probe_crates(name, base="https://crates.io/api/v1/crates", **kw):
    status, data = _get(f"{base}/{name}")
    if status == 404:
        return {"status": "free"}
    if isinstance(data, dict) and "crate" in data and data["crate"]:
        c = data["crate"]
        return {"status": "taken", "description": c.get("description"), "downloads": c.get("downloads")}
    if isinstance(data, dict) and "errors" in data:
        return {"status": "free"}
    return {"status": "unknown"}


def probe_npm(name, base="https://registry.npmjs.org", **kw):
    status, data = _get(f"{base}/{name}")
    if status == 404:
        return {"status": "free"}
    if status == 200 and isinstance(data, dict):
        return {"status": "taken", "description": (data.get("description") or "")[:60]}
    return {"status": "unknown"}


def probe_http(name, url, **kw):
    status, _ = _get(url.replace("{name}", name))
    if status == 404:
        return {"status": "free"}
    if status == 200:
        return {"status": "taken"}
    return {"status": "unknown"}


def probe_github(name, **kw):
    status, data = _get(
        f"https://api.github.com/search/repositories?q={name}+in:name&sort=stars&order=desc&per_page=3")
    if status == 200 and isinstance(data, dict) and "items" in data:
        hits = [{"repo": it["full_name"], "stars": it["stargazers_count"]} for it in data["items"][:3]]
        return {"status": "hits", "top": hits}
    return {"status": "unknown", "detail": (data or {}).get("message") if isinstance(data, dict) else None}


BUILTIN_PROBES = {"pypi": probe_pypi, "crates": probe_crates, "npm": probe_npm, "github": probe_github}


def classify(token, namespaces, watchlist, alias_ok, claim_after_years):
    reasons = []
    gate = "free"
    taken = {ns: st for ns, st in namespaces.items() if st.get("status") == "taken"}
    pypi_reclaimable = False
    if "pypi" in taken and taken["pypi"].get("last_upload"):
        try:
            up = taken["pypi"]["last_upload"][:10]
            age = (datetime.date.today() - datetime.date.fromisoformat(up)).days / 365.0
            pypi_reclaimable = age > claim_after_years
        except Exception:
            pass
    if len(taken) == 1 and "pypi" in taken and pypi_reclaimable:
        gate = "541-claimable"
        reasons.append(f"pypi taken but last upload {taken['pypi']['last_upload'][:10]} is "
                       f">{claim_after_years}y old (verify owner non-responsive before filing)")
    elif taken:
        gate = "taken"
        for ns, st in sorted(taken.items()):
            reasons.append(f"{ns}: taken ({st.get('summary') or st.get('description') or st.get('detail')})")
        if pypi_reclaimable:
            reasons.append("pypi is >{claim_after_years}y idle (reclaimable via PEP 541), "
                           "but other namespaces are still taken".format(claim_after_years=claim_after_years))
    if gate == "free" and token in watchlist:
        gate = "collision"
        reasons.append(watchlist[token]["note"] + " (see watchlist)")
    if not alias_ok:
        reasons.append("natural alias is reserved")
        if gate == "free":
            gate = "collision"
    return gate, reasons


def main(argv=None):
    p = argparse.ArgumentParser(description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("names", nargs="+", help="name token(s) to probe")
    p.add_argument("--config", help="JSON file: {registries:[{name,kind,url}], watchlist:{...}}")
    p.add_argument("--add-registry", nargs=3, action="append", metavar=("NAME", "KIND", "URL"),
                   dest="add_registry", help="e.g. --add-registry gitea http 'https://x/api/{name}'")
    p.add_argument("--alias", help="proposed 2-letter alias to check against the reserved list")
    p.add_argument("--only", help="comma list of namespaces to check (default: pypi,crates,npm,github)")
    p.add_argument("--claim-after-years", type=float, default=3.0,
                   help="treat a taken PyPI name as 541-claimable after this many years idle")
    args = p.parse_args(argv)

    probes = dict(BUILTIN_PROBES)
    watchlist = dict(DEFAULT_WATCHLIST)
    if args.config:
        with open(args.config) as f:
            cfg = json.load(f)
        for reg in cfg.get("registries", []):
            probes[reg["name"]] = (probe_http if reg["kind"] == "http" else BUILTIN_PROBES.get(reg["kind"]))
            if probes[reg["name"]] is None:
                print(f"unknown registry kind {reg['kind']}", file=sys.stderr)
                return 2
            probes[reg["name"]] = _bind(reg["url"])
        watchlist.update({k: {"brand": v.get("brand", ""), "note": v.get("note", "")}
                          for k, v in cfg.get("watchlist", {}).items()})
    if args.add_registry:
        for name, kind, url in args.add_registry:
            if kind == "http":
                probes[name] = _bind(url)
            elif kind in BUILTIN_PROBES:
                probes[name] = _bind(url, kind)
            else:
                print(f"unknown registry kind {kind}", file=sys.stderr)
                return 2

    only = args.only.split(",") if args.only else None
    alias_ok = True
    if args.alias:
        alias_ok = args.alias.lower() not in RESERVED_ALIASES

    result = []
    all_free = True
    for name in args.names:
        namespaces = {}
        for ns, fn in sorted(probes.items()):
            if only and ns not in only:
                continue
            try:
                namespaces[ns] = fn(name)
            except Exception as e:
                namespaces[ns] = {"status": "unknown", "detail": str(e)}
        gate, reasons = classify(name.lower(), namespaces, watchlist, alias_ok, args.claim_after_years)
        if gate != "free":
            all_free = False
        result.append({"token": name, "gate": gate, "reasons": reasons, "namespaces": namespaces})

    print(json.dumps(result, indent=2))
    return 0 if all_free else 1


def _bind(url, kind="http"):
    if kind == "pypi":
        return lambda name: probe_pypi(name, base=url.rstrip("/json"))
    if kind == "crates":
        return lambda name: probe_crates(name, base=url)
    if kind == "npm":
        return lambda name: probe_npm(name, base=url)
    return lambda name: probe_http(name, url=url)


if __name__ == "__main__":
    sys.exit(main())
