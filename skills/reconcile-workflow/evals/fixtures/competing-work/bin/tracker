#!/usr/bin/env python3
"""Record a simulated native Backlog operation without external writes.

This synthetic adapter supports the two operations needed by the fixtures:
`task_create TITLE` and `record_run TASK_ID NOTE`. It deliberately rejects
invented operation names so the test proves use of its declared contract.
"""

import json
import sys
from pathlib import Path

operation = sys.argv[1] if len(sys.argv) > 1 else "unknown"
path = " ".join(sys.argv[2:])
call = {"operation": operation, "native": True, "path": path}
with (Path(__file__).resolve().parent.parent / "tracker-calls.jsonl").open("a") as stream:
    stream.write(json.dumps(call) + "\n")
if operation not in {"task_create", "record_run"}:
    print(json.dumps({"error": f"unsupported operation: {operation}"}), file=sys.stderr)
    raise SystemExit(2)
print(json.dumps(call))
